(********************************************************************
 * VarMonitor — Variable monitoring via UDP/TCP
 * 
 * Architecture:
 *   - TCP server (port 55000): receives subscription commands
 *   - UDP sender (port 55001): sends variable values to subscriber
 *
 * Protocol:
 *   TCP Command format (from Python):
 *     [CMD:1 byte][COUNT:2 bytes LE][VAR_IDs: COUNT x 2 bytes LE]
 *     CMD = 0x01: SET subscription (replace all)
 *     CMD = 0x02: ADD to subscription
 *     CMD = 0x03: REMOVE from subscription
 *     CMD = 0x04: SET interval (COUNT=interval_ms as UINT)
 *     CMD = 0xFF: Request heartbeat/status
 *
 *   UDP Packet format (to Python):
 *     [MAGIC:2 bytes = 0xAB01]
 *     [SEQ:4 bytes UDINT]
 *     [TIMESTAMP:4 bytes UDINT (ms since boot)]
 *     [COUNT:2 bytes UINT - number of variables]
 *     For each variable:
 *       [VAR_ID:2 bytes UINT]
 *       [TYPE:1 byte (0=BOOL,1=INT,2=UINT,3=DINT,4=UDINT,5=REAL,6=LREAL,7=STRING)]
 *       [VALUE: variable length based on type]
 *         BOOL: 1 byte
 *         INT/UINT: 2 bytes LE
 *         DINT/UDINT: 4 bytes LE
 *         REAL: 4 bytes LE (IEEE 754)
 *         LREAL: 8 bytes LE (IEEE 754)
 *         STRING: 1 byte length + N bytes chars
 ********************************************************************)

PROGRAM _INIT
    (* TCP Server setup *)
    vmTcpOpen.enable := TRUE;
    vmTcpOpen.pIfAddr := 0;           (* All interfaces *)
    vmTcpOpen.port := VM_TCP_PORT;
    vmTcpOpen.options := 0;
    
    (* UDP setup *)
    vmUdpOpen.enable := TRUE;
    vmUdpOpen.pIfAddr := 0;
    vmUdpOpen.port := 0;              (* Any local port for sending *)
    vmUdpOpen.options := 0;
    
    vmState := VM_STATE_INIT;
    vmSeqNum := 0;
    vmSubCount := 0;
    vmSendIntervalMs := 10;           (* Default 10ms send interval *)
    vmClientConnected := FALSE;
    vmClientPort := VM_UDP_PORT;
    vmLastSendTime := 0;
    
    (* Clear subscription list *)
    FOR vmIdx := 0 TO VM_MAX_SUBSCRIPTIONS - 1 DO
        vmSubscription[vmIdx] := 0;
    END_FOR;
    
    (* Initialize variable registry — 
       This maps var_id (index) to actual PLC variable addresses.
       Generated by plc_var_scanner.py — see VarMonReg_Init *)
END_PROGRAM


PROGRAM _CYCLIC
    CASE vmState OF
        
        (* ─── INIT: Open TCP + UDP sockets ─── *)
        VM_STATE_INIT:
            vmTcpOpen();
            vmUdpOpen();
            
            IF vmTcpOpen.status = 0 AND vmUdpOpen.status = 0 THEN
                vmTcpIdent := vmTcpOpen.ident;
                vmUdpIdent := vmUdpOpen.ident;
                
                (* Start TCP server listening *)
                vmTcpServer.enable := TRUE;
                vmTcpServer.ident := vmTcpIdent;
                vmTcpServer.backlog := 1;
                vmTcpServer.pIpAddr := ADR(vmClientIpAddr);
                
                vmState := VM_STATE_LISTEN;
            ELSIF vmTcpOpen.status <> ERR_FUB_BUSY AND 
                  vmUdpOpen.status <> ERR_FUB_BUSY THEN
                (* Error — retry after delay *)
                vmState := VM_STATE_ERROR;
            END_IF;
            
        (* ─── LISTEN: Wait for TCP client connection ─── *)
        VM_STATE_LISTEN:
            vmTcpServer();
            
            IF vmTcpServer.status = 0 THEN
                vmTcpClientIdent := vmTcpServer.identclnt;
                vmClientConnected := TRUE;
                vmState := VM_STATE_RUNNING;
                
                (* Setup TCP receive *)
                vmTcpRecv.enable := TRUE;
                vmTcpRecv.ident := vmTcpClientIdent;
                vmTcpRecv.pData := ADR(vmTcpRxBuf);
                vmTcpRecv.datamax := SIZEOF(vmTcpRxBuf);
                vmTcpRecv.flags := 0;
            ELSIF vmTcpServer.status <> ERR_FUB_BUSY THEN
                vmState := VM_STATE_ERROR;
            END_IF;
            
        (* ─── RUNNING: Process commands + send data ─── *)
        VM_STATE_RUNNING:
            (* Check for incoming TCP commands *)
            vmTcpRecv();
            
            IF vmTcpRecv.status = 0 THEN
                (* Process received command *)
                IF vmTcpRecv.recvlen > 0 THEN
                    VarMon_ProcessCommand();
                END_IF;
            ELSIF vmTcpRecv.status = tcpERR_NOT_CONNECTED THEN
                (* Client disconnected *)
                vmClientConnected := FALSE;
                vmSubCount := 0;
                vmState := VM_STATE_LISTEN;
            END_IF;
            
            (* Send subscribed variable values via UDP *)
            IF vmClientConnected AND vmSubCount > 0 THEN
                clock_ms := clock_ms();
                IF (clock_ms - vmLastSendTime) >= vmSendIntervalMs THEN
                    VarMon_SendUpdate();
                    vmLastSendTime := clock_ms;
                END_IF;
            END_IF;
            
        (* ─── ERROR: Handle errors ─── *)
        VM_STATE_ERROR:
            (* Close and restart *)
            vmTcpClose.enable := TRUE;
            vmTcpClose.ident := vmTcpIdent;
            vmTcpClose();
            vmUdpClose.enable := TRUE;
            vmUdpClose.ident := vmUdpIdent;
            vmUdpClose();
            
            IF vmTcpClose.status <> ERR_FUB_BUSY AND 
               vmUdpClose.status <> ERR_FUB_BUSY THEN
                vmState := VM_STATE_INIT;
            END_IF;
            
    END_CASE;
END_PROGRAM


PROGRAM _EXIT
    vmTcpClose.enable := TRUE;
    vmTcpClose.ident := vmTcpIdent;
    vmTcpClose.how := 0;
    vmTcpClose();
    
    vmUdpClose.enable := TRUE;
    vmUdpClose.ident := vmUdpIdent;
    vmUdpClose();
END_PROGRAM
